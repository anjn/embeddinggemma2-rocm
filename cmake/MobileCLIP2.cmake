file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/mc2-deps")
if(NOT EXISTS "${CMAKE_BINARY_DIR}/mc2-deps/json.hpp")
 file(DOWNLOAD "https://raw.githubusercontent.com/nlohmann/json/v3.11.3/single_include/nlohmann/json.hpp" "${CMAKE_BINARY_DIR}/mc2-deps/json.hpp" TLS_VERIFY ON STATUS mc2_download)
 if(NOT mc2_download MATCHES "^0;")
  message(FATAL_ERROR "Cannot fetch JSON header: ${mc2_download}")
 endif()
endif()
find_package(OpenSSL REQUIRED COMPONENTS Crypto)
option(MC2_GPU "Enable MobileCLIP2 MIGraphX backend" ON)
option(MC2_NPU "Enable MobileCLIP2 VitisAI backend" ON)
set(MC2_ORT_ROOT "" CACHE PATH "ONNX Runtime SDK root (Ryzen AI venv/onnxruntime for NPU)")
set(MC2_ORT_LIBRARY "" CACHE FILEPATH "ONNX Runtime shared library")
find_path(MC2_ORT_INCLUDE onnxruntime_cxx_api.h PATHS "${MC2_ORT_ROOT}/include/onnxruntime" "${MC2_ORT_ROOT}/include" REQUIRED)
if(NOT MC2_ORT_LIBRARY)
 find_library(MC2_ORT_FOUND NAMES onnxruntime libonnxruntime.so.1.30.0 PATHS "${MC2_ORT_ROOT}/lib" REQUIRED)
 set(MC2_ORT_LIBRARY "${MC2_ORT_FOUND}" CACHE FILEPATH "ONNX Runtime shared library" FORCE)
endif()
find_program(MC2_CARGO cargo REQUIRED)
set(MC2_TOKENIZER "${CMAKE_BINARY_DIR}/mc2-tokenizer/release/libeg2_tokenizer.a")
add_custom_command(OUTPUT "${MC2_TOKENIZER}" COMMAND ${MC2_CARGO} build --locked --release --manifest-path "${PROJECT_SOURCE_DIR}/tokenizer/Cargo.toml" --target-dir "${CMAKE_BINARY_DIR}/mc2-tokenizer" DEPENDS tokenizer/Cargo.toml tokenizer/Cargo.lock tokenizer/src/lib.rs VERBATIM)
add_custom_target(mc2-tokenizer-build DEPENDS "${MC2_TOKENIZER}")
add_library(mobileclip2 SHARED src/mobileclip2.cpp)
add_dependencies(mobileclip2 mc2-tokenizer-build)
target_link_options(mobileclip2 PRIVATE "LINKER:--exclude-libs,ALL")
target_include_directories(mobileclip2 PUBLIC $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:include> PRIVATE "${MC2_ORT_INCLUDE}" "${CMAKE_BINARY_DIR}/mc2-deps")
target_link_libraries(mobileclip2 PRIVATE OpenSSL::Crypto "${MC2_ORT_LIBRARY}" "${MC2_TOKENIZER}" dl pthread m)
if(MC2_GPU)
 find_path(MC2_MG_INCLUDE migraphx/migraphx.h PATHS "${ROCM_ROOT}/include" REQUIRED NO_DEFAULT_PATH)
 find_library(MC2_MG_LIBRARY NAMES migraphx_c libmigraphx_c.so.3 PATHS "${ROCM_ROOT}/lib" REQUIRED NO_DEFAULT_PATH)
 target_include_directories(mobileclip2 PRIVATE "${MC2_MG_INCLUDE}")
 target_link_libraries(mobileclip2 PRIVATE "${MC2_MG_LIBRARY}")
 target_compile_definitions(mobileclip2 PRIVATE MC2_GPU=1)
endif()
if(MC2_NPU)
 target_compile_definitions(mobileclip2 PRIVATE MC2_NPU=1)
endif()
set_target_properties(mobileclip2 PROPERTIES VERSION ${PROJECT_VERSION} SOVERSION 0 CXX_VISIBILITY_PRESET hidden INSTALL_RPATH_USE_LINK_PATH TRUE)
add_executable(mc2-example examples/mobileclip2.cpp)
target_link_libraries(mc2-example PRIVATE mobileclip2)
add_executable(mc2-example-c examples/mobileclip2.c)
target_link_libraries(mc2-example-c PRIVATE mobileclip2)
set_target_properties(mc2-example mc2-example-c PROPERTIES INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
install(TARGETS mobileclip2 mc2-example mc2-example-c LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(DIRECTORY include/mobileclip2 DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
